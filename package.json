{
  "name": "dsh-shift-router",
  "version": "0.3.0",
  "description": "Two-tier model router for DeepSeek Harness — automatic execution/judgment routing with LLM Judge, multi-model fallback chains, and exponential-backoff runtime failover. A DSH adaptation of pi-shift-router.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "shift-router",
    "model-routing",
    "llm-router",
    "two-tier-routing",
    "multi-model-fallback",
    "exponential-backoff",
    "agent-failover",
    "llm-judge"
  ],
  "license": "MIT",
  "homepage": "https://github.com/green-dalii/dsh-shift-router#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/green-dalii/dsh-shift-router.git"
  },
  "bugs": {
    "url": "https://github.com/green-dalii/dsh-shift-router/issues"
  },
  "author": {
    "name": "green-dalii",
    "url": "https://github.com/green-dalii"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "package.json",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules dist",
    "prepare": "tsc"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}